# Postgres. Neon or Supabase free tier is plenty.
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Admin passphrase. Distinct from every entrant link. Long and boring is fine.
ADMIN_PASSPHRASE=

# Secret used to sign the admin session cookie. Any long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
